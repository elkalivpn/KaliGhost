FROM kalilinux/kali-rolling

LABEL maintainer="elkalivpn@kalighost.dev" \
    description="KaliGhost - Sistema de pentesting autónomo con IA" \
    version="1.0"

ENV DEBIAN_FRONTEND=noninteractive \
    KALI_RollING=true

# Actualizar e instalar herramientas básicas
RUN apt-get update && apt-get install -y \
    git \
    python3 \
    python3-pip \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario kalighost
RUN useradd -m -s /bin/bash kalighost

WORKDIR /home/kalighost

# Copiar el repositorio
COPY . /home/kalighost/KaliGhost

# Dar permisos
RUN chown -R kalighost:kalighost /home/kalighost

USER kalighost
WORKDIR /home/kalighost/KaliGhost

# Exponer puertos
EXPOSE 22 80 443 8080 9001

CMD ["bash"]