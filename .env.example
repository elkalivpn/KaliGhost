KALIGHOST_VERSION=1.0.0

# Docker
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# Ollama (modelo local)
OLLAMA_HOST=http://localhost:11434

# Proton (identidad y vault)
PROTON_API_KEY=your_proton_api_key_here
PROTON_PASSWORD=your_proton_password_here

# AWS Bedrock (opcional - solo para desarrollo)
AWS_BEARER_TOKEN_BEDROCK=your_aws_bedrock_token_here
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# API Keys (opcionales)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Configuración del agente
AGENT_NAME=YrYs
AGENT_LANGUAGE=es

# Puertos
UI_PORT=8081
API_PORT=9001
OBSERVABILITY_PORT=9002