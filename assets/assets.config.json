{
  "assetMetadata": {
    "project": "KaliGhost Pro",
    "version": "2.0.0",
    "author": "KaliGhost Professional Design Team",
    "license": "Proprietary - See LICENSE",
    "created": "2026-05-15",
    "lastModified": "2026-05-15"
  },
  "categories": {
    "icons": {
      "path": "icons/",
      "formats": ["svg", "png"],
      "sizes": [16, 24, 32, 48, 64, 128, 256, 512],
      "namingConvention": "{category}-{name}-{size}.{extension}",
      "optimization": {
        "svg": {
          "minify": true,
          "removeMetadata": true,
          "precision": 2
        },
        "png": {
          "compression": "pngquant",
          "quality": "80-90",
          "interlace": false
        }
      }
    },
    "models": {
      "path": "models/",
      "formats": ["obj", "fbx", "glb", "gltf"],
      "textures": {
        "path": "models/textures/",
        "formats": ["png", "jpg", "jpeg"],
        "resolution": [512, 1024, 2048, 4096],
        "compression": "BC7"
      },
      "lodLevels": 3,
      "animation": {
        "supported": true,
        "formats": ["fbx", "glb"],
        "frameRate": 30
      }
    },
    "themes": {
      "path": "themes/",
      "formats": ["json", "css", "scss"],
      "variants": ["dark", "light", "high-contrast"],
      "colors": {
        "primary": "#22AA55",
        "secondary": "#00C8FF",
        "accent": "#FF3296",
        "background": "#0F0F1E",
        "text": "#DADADA"
      }
    },
    "sounds": {
      "path": "sounds/",
      "formats": ["wav", "mp3", "ogg"],
      "sampleRate": 44100,
      "bitDepth": 16,
      "channels": 2,
      "normalization": -3,
      "categories": ["interface", "system", "security", "ambient"]
    }
  },
  "optimizationSettings": {
    "compression": {
      "enabled": true,
      "level": "high",
      "preserveQuality": true
    },
    "caching": {
      "enabled": true,
      "strategy": "immutable",
      "maxAge": 31536000
    },
    "preloading": {
      "criticalAssets": [
        "icons/actions/scan-24.svg",
        "icons/tools/nmap-32.svg",
        "icons/status/online-16.svg"
      ],
      "priority": "high"
    }
  },
  "accessibility": {
    "contrastRatios": {
      "minimum": 4.5,
      "enhanced": 7.0
    },
    "alternativeText": {
      "required": true,
      "maxLength": 150
    },
    "colorBlindness": {
      "simulation": true,
      "friendly": true
    }
  },
  "integration": {
    "framework": "PySide6",
    "resourceSystem": "Qt Resource System",
    "fallbackAssets": {
      "enabled": true,
      "path": "assets/fallbacks/"
    },
    "responsive": {
      "vectorPreferred": true,
      "densitySupport": [1, 1.5, 2, 3]
    }
  }
}